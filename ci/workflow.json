{
  "attest": true,
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "aarch64-windows-gnu",
    "x86_64-macos",
    "aarch64-macos",
    "x86_64-freebsd"
  ],
  "compile_once": true,
  "hardened": true,
  "jobs": [
    {
      "name": "sanitized runtime",
      "step": "test",
      "args": [
        "-Dsanitize_c=true"
      ],
      "tiers": [
        "merge",
        "release"
      ],
      "setup": false,
      "timeout": 30
    },
    {
      "name": "vendor",
      "step": "check-vendor",
      "tiers": [
        "release"
      ],
      "setup": false,
      "timeout": 15
    },
    {
      "name": "all grammars",
      "step": "check-grammars",
      "args": [
        "-Dgrammars=all"
      ],
      "tiers": [
        "release"
      ],
      "setup": false,
      "timeout": 180
    }
  ]
}
