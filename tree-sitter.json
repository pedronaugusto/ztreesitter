{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "enforce",
      "camelcase": "Enforce",
      "scope": "source.enforce",
      "path": ".",
      "file-types": [
        "c"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "tags": [
        "queries/tags.scm"
      ],
      "injection-regex": "^enforce$"
    }
  ],
  "metadata": {
    "version": "0.4.0",
    "license": "MIT",
    "description": "Enforce Script",
    "authors": [
      {
        "name": "simonvic",
        "email": "simonvic.dev@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/simonvic/tree-sitter-enforce"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
